# Copy to .env.local and fill in.
# Local: run `npx supabase status` in pawmates-backend.
# Cloud: Supabase dashboard -> Project Settings -> API Keys (publishable key only).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Push notifications (optional; the "turn on notifications" option is hidden
# without NEXT_PUBLIC_VAPID_PUBLIC_KEY). Generate a key pair with
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# PUSH_WEBHOOK_SECRET must match the push_webhook_secret Vault secret in the
# Supabase project (see migration 020_push.sql).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_WEBHOOK_SECRET=
